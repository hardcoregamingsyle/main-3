# ===========================================
# MoE Ultra Engine Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ===========================================

# -------------------------------------------
# Application Settings
# -------------------------------------------
ENVIRONMENT=development
APP_NAME=moe-ultra-engine
APP_VERSION=1.0.0
DEBUG=false

# -------------------------------------------
# Server Configuration
# -------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# -------------------------------------------
# Model Configuration
# -------------------------------------------
MODEL_PATH=./models/qwen-3.8-max
MODEL_TYPE=qwen
MAX_SEQ_LENGTH=8192
MAX_NEW_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1

# Enable/disable quantization
USE_QUANTIZATION=true
QUANTIZATION_BITS=4
OFFLOAD_TO_CPU=false

# -------------------------------------------
# Hardware Configuration
# -------------------------------------------
# Available options: cuda, mps, cpu
DEVICE=cuda
GPU_ID=0
NUM_GPUS=1

# Memory limits (in MB)
MAX_MEMORY_MB=32768
GPU_MEMORY_FRACTION=0.9

# -------------------------------------------
# API Configuration
# -------------------------------------------
API_KEY_SECRET=your-secret-key-here-change-in-production
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=120

# CORS settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# -------------------------------------------
# Database Configuration
# -------------------------------------------
DATABASE_URL=sqlite:///./data/conversations.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily

# -------------------------------------------
# Prometheus/Metrics Configuration
# -------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_ENDPOINT=/metrics

# -------------------------------------------
# Cache Configuration
# -------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# -------------------------------------------
# Security Configuration
# -------------------------------------------
SECURITY_HEADERS=true
CSRF_ENABLED=true
SESSION_SECRET=change-this-to-random-32-char-string

# -------------------------------------------
# External Services (Optional)
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# S3 for model storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=models
AWS_REGION=us-east-1

# -------------------------------------------
# Development Only
# -------------------------------------------
TEST_MODE=false
MOCK_EXTERNAL_SERVICES=false
ANONYMIZED_ANALYTICS=false

# End of .env.example