# Application
APP_NAME=MoE Ultra Engine
APP_ENV=development
DEBUG=true
PORT=3000
HOST=0.0.0.0

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/moe.db

# Model
MODEL_PATH=./models
DEFAULT_MODEL=Qwen-3.8-Max

# Memory
MEMORY_BUDGET_MB=32000
EXPERT_CACHE_BUDGET_MB=4096

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
