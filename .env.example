# Application Configuration
APP_NAME=moe-ultra-engine
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_LOG_LEVEL=info

# Server Configuration
SERVER_HOST=0.0.0.0
WORKERS_COUNT=1

# Database Configuration
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moe_engine_db
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_POOL_SIZE=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Configuration
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
API_KEY_HEADER=X-API-Key
INTERNAL_API_KEY=generate_secure_key_here
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Model Configuration
MODEL_PATH=./models/Qwen-3.8-Max
MODEL_TYPE=qwen
QUANTIZATION_MODE=int8
MAX_SEQ_LEN=4096
OFFLOAD_ENABLED=true
OFFLOAD_DEVICE=cpu

# Logging & Monitoring
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_DASHBOARD_ID=12345

# Third Party Integrations
HUGGING_FACE_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=model-storage

# Feature Flags
ENABLE_METRICS=true
ENABLE_AUTH=false
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60
