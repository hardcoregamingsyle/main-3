# MoE Ultra Engine Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Model Configuration
# ==========================================
# Hugging Face model ID or local path
MODEL_ID=Qwen/Qwen1.5-MoE-A2.7B
# MODEL_ID=/path/to/local/model

# Model revision/branch
MODEL_REVISION=main

# Hugging Face token for private/gated models
HF_TOKEN=

# ==========================================
# Memory & Offloading Configuration
# ==========================================
# Maximum GPU memory to use (in GB). Set to 0 for CPU-only.
MAX_GPU_MEMORY_GB=4

# Maximum CPU RAM to use for model offloading (in GB)
MAX_CPU_MEMORY_GB=28

# Maximum disk space for offloading (in GB)
MAX_DISK_MEMORY_GB=50

# Offloading strategy: "auto", "sequential", "layer_wise", "expert_wise"
OFFLOAD_STRATEGY=expert_wise

# Enable layer prefetching
ENABLE_PREFETCH=true

# Number of layers to prefetch
PREFETCH_LAYERS=2

# ==========================================
# Quantization Configuration
# ==========================================
# Quantization method: "none", "int8", "int4", "nf4", "fp8", "gptq", "awq"
QUANTIZATION=int4

# Quantization compute dtype: "float16", "bfloat16", "float32"
QUANT_COMPUTE_DTYPE=bfloat16

# Use double quantization for 4-bit
USE_DOUBLE_QUANT=true

# ==========================================
# MoE-Specific Configuration
# ==========================================
# Number of experts to keep in GPU memory simultaneously
EXPERTS_ON_GPU=2

# Expert offloading policy: "lru", "frequency", "static"
EXPERT_OFFLOAD_POLICY=frequency

# Top-k routing (for inference optimization)
MOE_TOP_K=2

# Enable expert parallelism if multiple GPUs
EXPERT_PARALLEL=false

# ==========================================
# Inference Configuration
# ==========================================
# Maximum sequence length
MAX_SEQ_LEN=8192

# Default generation max new tokens
DEFAULT_MAX_NEW_TOKENS=512

# Default temperature
DEFAULT_TEMPERATURE=0.7

# Default top-p
DEFAULT_TOP_P=0.9

# Default top-k
DEFAULT_TOP_K=50

# Repetition penalty
REPETITION_PENALTY=1.1

# ==========================================
# API Server Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=3000
API_WORKERS=1

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=4

# Enable request queuing
ENABLE_QUEUE=true

# Queue max size
QUEUE_MAX_SIZE=100

# ==========================================
# Logging & Monitoring
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# Enable metrics endpoint
ENABLE_METRICS=true
METRICS_PORT=9090

# ==========================================
# Storage Paths
# ==========================================
# Model cache directory
MODEL_CACHE_DIR=/data/models

# Offload directory (for disk offloading)
OFFLOAD_DIR=/data/offload

# Log directory
LOG_DIR=/var/log/moe-engine

# ==========================================
# Performance Tuning
# ==========================================
# Torch compile mode: "none", "reduce-overhead", "max-autotune"
TORCH_COMPILE=reduce-overhead

# Enable flash attention
USE_FLASH_ATTN=true

# Number of data loader workers
DATA_LOADER_WORKERS=2

# Pin memory for data loading
PIN_MEMORY=true

# ==========================================
# Security
# ==========================================
# API key for authentication (optional)
API_KEY=

# CORS origins (comma-separated)
CORS_ORIGINS=*

# Rate limit (requests per minute)
RATE_LIMIT_RPM=60
