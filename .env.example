# ========================================
# MoE Ultra Engine Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ========================================
# MODEL CONFIGURATION
# ========================================
MODEL_NAME=qwen-2.4t-moe
MODEL_PATH=/models/qwen-2.4t-moe
QUANTIZATION_LEVEL=INT4
NUM_EXPERTS=128
NUM_ACTIVE_EXPERTS=16
MOE_ROUTING_TYPE=topk

# ========================================
# INFERENCE SETTINGS
# ========================================
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPEAT_PENALTY=1.1
STOP_TOKENS=["<eos>", "</s>"]

# ========================================
# HARDWARE RESOURCES
# ========================================
GPU_DEVICE=0
CPU_THREADS=8
MEMORY_LIMIT_GB=32
OFFLOAD_TO_CPU=true

# ========================================
# API SERVER
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
API_RATE_LIMIT_RPM=100
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# SECURITY (Generate these values!)
# ========================================
JWT_SECRET_KEY=your-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
ADMIN_PASSWORD=change-me-first-time-login

# ========================================
# DATABASE
# ========================================
DATABASE_URL=sqlite:///./moe_ultra.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ========================================
# MONITORING & TELEMETRY
# ========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_DATASOURCE_URL=http://grafana:3000
TELEMETRY_ENDPOINT=https://telemetry.thalamus.ai/api/v1/events
ANONYMIZED_DATA=false

# ========================================
# CACHE
# ========================================
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=1024
REDIS_URL=redis://localhost:6379/0

# ========================================
# FILE STORAGE
# ========================================
STORAGE_BACKEND=local
STORAGE_PATH=./storage
STORAGE_MAX_SIZE_GB=100

# ========================================
# DEVELOPMENT ONLY (Set to false in production)
# ========================================
DEV_MODE=false
ALLOW_DEBUG_ENDPOINTS=true
ENABLE_PROFILING=false
