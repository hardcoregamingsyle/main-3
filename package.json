{
  "name": "moe-ultra-engine",
  "version": "1.0.0",
  "description": "Ultra-memory-efficient MoE inference engine for running 2.4T parameter models on consumer hardware",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,yaml,yml,css,scss}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.4.19",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.5",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.17",
    "chart.js": "^4.4.1",
    "vue-chartjs": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.10",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vue-tsc": "^1.8.25",
    "vitest": "^1.2.1",
    "@vitest/coverage-v8": "^1.2.1",
    "@playwright/test": "^1.41.2",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "prettier": "^3.2.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  }
}