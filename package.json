{
  "name": "moe-ultra-engine",
  "version": "1.0.0",
  "description": "Ultra-memory-efficient MoE inference engine for running 2.4T parameter models on consumer hardware",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,yaml,yml,css,scss}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "dependencies": {
    "vue": "^3.4.19",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.5",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vue-tsc": "^2.0.6",
    "typescript": "~5.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "prettier": "^3.2.5",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@playwright/test": "^1.41.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
