{
  "name": "moe-ultra-engine",
  "version": "1.0.0",
  "description": "Ultra-memory-efficient MoE inference engine for running 2.4T parameter models on consumer hardware",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,yaml,yml,css,scss}\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "vue": "^3.4.19",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.5",
    "nanoid": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vue-tsc": "^1.8.27",
    "vitest": "^1.3.0",
    "@vitest/coverage-istanbul": "^1.3.0",
    "@playwright/test": "^1.42.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "prettier": "^3.2.4",
    "@vue/eslint-config-typescript": "^12.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ]
}