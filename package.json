{
  "name": "moe-ultra-engine",
  "version": "1.0.0",
  "description": "Ultra-memory-efficient MoE inference engine for running 2.4T parameter models on consumer hardware",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,yaml,yml,css,scss}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "dependencies": {
    "vue": "^3.4.19",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.20.0",
    "husky": "^8.0.3",
    "prettier": "^3.2.0",
    "typescript": "~5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-compression": "^0.5.0",
    "vitest": "^1.2.0",
    "vue-tsc": "^1.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}